<?xml version="1.0" encoding="utf-8"?>
<CatapultGlossary>
  <GlossaryEntry
    glossTerm="Glossary.Term1"
    Stem=""
    IgnoreCase="false">
    <Terms>
      <Term>Asana</Term>
    </Terms>
    <Definition
      Link="">Asana yoga is the practice of performing physical yoga postures, known as "asanas," to build strength, flexibility, and balance while preparing the body for meditation and promoting mental calm.</Definition>
  </GlossaryEntry>
  <GlossaryEntry
    glossTerm="Glossary.Term3"
    Stem=""
    IgnoreCase="false">
    <Terms>
      <Term>Saucha</Term>
    </Terms>
    <Definition
      Link="">Saucha is the Sanskrit word for purity or cleanliness, and it is the first of the Niyamas (personal observances) in Patanjali's Yoga Sutras. It involves the practice of both internal and external purity, including keeping your body and surroundings clean, maintaining a healthy diet, practicing self-care, and cultivating mental clarity.</Definition>
  </GlossaryEntry>
  <GlossaryEntry
    glossTerm="Glossary.Term4"
    Stem=""
    IgnoreCase="false">
    <Terms>
      <Term>Mitahara</Term>
    </Terms>
    <Definition
      Link="">Mitahara refers to mindful, moderate, and pure eating in the yogic tradition, focusing on the quality and quantity of food to achieve physical and mental harmony.</Definition>
  </GlossaryEntry>
  <GlossaryEntry
    glossTerm="Glossary.Term5"
    Stem=""
    IgnoreCase="false">
    <Terms>
      <Term>Tapas</Term>
    </Terms>
    <Definition
      Link="">Tapas refers to self-discipline, inner fire, and the practice of burning away negative habits and impurities to achieve spiritual and personal growth</Definition>
  </GlossaryEntry>
  <GlossaryEntry
    glossTerm="Glossary.Term0"
    Stem=""
    IgnoreCase="false">
    <Terms>
      <Term>Patanjali</Term>
    </Terms>
    <Definition
      Link="">Patanjali was an ancient Indian sage and philosopher best known for compiling the Yoga Sutras, a foundational text for yoga, and for his work as a Sanskrit grammarian and commentator on texts related to Ayurveda (traditional medicine). The Yoga Sutras, a collection of aphorisms outlining the path to spiritual liberation, are considered the most authoritative text on classical yoga, making Patanjali the widely recognized "father of yoga".</Definition>
  </GlossaryEntry>
</CatapultGlossary>